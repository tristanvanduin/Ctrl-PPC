# =====================================================================================
# Voorbeeld-omgevingsvariabelen voor het Dashboard.
#
# Kopieer dit bestand naar .env.local (lokaal) of zet de waarden in je host
# (bijv. Vercel: Settings -> Environment Variables) en deploy opnieuw. .env.local staat
# in .gitignore en hoort NOOIT gecommit te worden. Vul echte waarden nooit in dit bestand in.
#
# OMSCHAKELEN NAAR EEN ANDERE SUPABASE: alleen de drie SUPABASE-waarden hieronder wijzen
# naar de database. De Google Ads-, Meta- en LinkedIn-koppelingen staan daar los van en
# blijven ongewijzigd; de sync schrijft simpelweg naar de Supabase waar deze URL naar wijst.
# =====================================================================================

# ── Supabase (verplicht) ─────────────────────────────────────────────────────────────
# URL en anon-key staan in Project Settings -> API. De service-role-key is server-only en
# omzeilt RLS: nooit naar de client sturen, nooit in NEXT_PUBLIC_ zetten.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side fallback voor de URL (scripts/seed-first-admin.mjs, lib/supabase-admin.ts).
# Laat leeg om NEXT_PUBLIC_SUPABASE_URL te hergebruiken, of zet dezelfde project-URL.
SUPABASE_URL=

# ── Google Ads (databron) ────────────────────────────────────────────────────────────
# Refresh-token genereer je eenmalig met scripts/get-refresh-token.ts (leest CLIENT_ID/SECRET).
#
# CLIENT_ID/CLIENT_SECRET zijn tegelijk de OAuth-client voor GA4 en Search Console (lib/tenancy/
# oauth-providers.ts) — één Google Cloud-project, drie scopes. Schakel daarvoor wel de Google
# Analytics Data API en de Search Console API in voor datzelfde project (naast de Google Ads API).
# REFRESH_TOKEN/MANAGER_CUSTOMER_ID hieronder zijn de terugval zonder een bureau-koppeling (zie
# lib/tenancy/credentials.ts) — met OAuth via de instellingenpagina ("Verbinden met Google Ads")
# hoeven deze twee niet meer handmatig gezet te worden.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_MANAGER_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=

# ── Google Merchant Center (optioneel; product-feed-verrijking) ───────────────────────
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_FEED_LABEL=
GOOGLE_MERCHANT_CONTENT_LANGUAGE=
GOOGLE_MERCHANT_CHANNEL=

# ── Meta (Facebook) Ads (optioneel; M-sporen) ─────────────────────────────────────────
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_VISION_MODEL=

# ── LinkedIn Ads (optioneel; L-sporen) ────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REFRESH_TOKEN=

# ── LLM (verplicht voor analyses) ─────────────────────────────────────────────────────
# De app praat via het OpenAI-compatibele chat-completions-formaat. Sinds masterplan Fase 3
# (15 augustus) is echt OpenRouter de standaardroute: zet LLM_BASE_URL en OPENROUTER_API_KEY. De
# modellen staan in lib/analysis/llm-router.ts (MODEL_CATALOG voor de bestaande heavy/medium/
# light-keten, LAYER_MODEL voor de nieuwe triage/reasoning/narrative/strategic-routering) en zijn
# geverifieerd tegen de live OpenRouter-catalogus, zie docs/ARCHITECTURE-MODEL-ROUTING.md.
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Terugval zonder OpenRouter-sleutel: laat LLM_BASE_URL leeg en zet GEMINI_API_KEY, dan gaat de
# app terug naar de directe Gemini-endpoint (zelfde chat-completions-formaat). Zet dan ook de
# model-ID's in MODEL_CATALOG/LAYER_MODEL om naar kale Gemini-namen zonder google/-voorvoegsel.
GEMINI_API_KEY=

# Maandplafond op het AI-verbruik, in euro. LEEG = GEEN PLAFOND, en dat is met opzet de
# standaard: een limiet die zichzelf aanzet legt op een dag een analyse stil zonder dat er ooit
# een bedrag is afgesproken. Vanaf 80% van het plafond komt er een melding; erboven weigert de
# chat met een 429 en de tekst waar de teller weer op nul gaat.
#
# De teller loopt over de kalendermaand (UTC) en telt llm_usage.cost_eur. Calls met een model dat
# niet in MODEL_PRICES staat hebben geen prijs en tellen dus niet mee; het plafond zegt dat er dan
# bij. Zie lib/analysis/uitgavenplafond.ts voor de vijf keuzes achter dit gedrag.
# LLM_MAAND_PLAFOND_EUR=50

# ── Auth / O1 (rollen en RLS) ─────────────────────────────────────────────────────────
# Laat O1_AUTH_ENFORCED leeg of 'false' zolang de auth-laag niet live is (pass-through).
# Zet op 'true' samen met migratie 001 + 017 en de eerste admin-seed.
O1_AUTH_ENFORCED=
# E-mail van de eerste admin voor scripts/seed-first-admin.mjs.
SEED_ADMIN_EMAIL=

# ── Cron / scheduler ──────────────────────────────────────────────────────────────────
# Gedeeld geheim dat de cron-routes en de backup-workflow beschermt.
CRON_SECRET=

# ── Observability / alerting (optioneel) ──────────────────────────────────────────────
SENTRY_DSN=
SLACK_WEBHOOK_URL=
# LOG_LEVEL: debug | info | warn | error (default info).
LOG_LEVEL=

# ── Bescherming van de publieke demo tegen kostende SOP-runs ──────────────────────────
# Handmatig SOP's triggeren werkt standaard OOK op de demo-klant, zodat je kunt testen.
# Zet dit op 1 zodra de demo publiek bereikbaar wordt voor mensen buiten je eigen team:
# dan zijn de SOP-knoppen daar uitgeschakeld en kan een bezoeker geen echte, kostende
# LLM-runs starten op jouw rekening.
NEXT_PUBLIC_SOP_DEMO_BLOKKADE=
